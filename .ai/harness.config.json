{
  "version": 1,
  "default_branch": "main",
  "quality_gate_commands": [
    "uv run --extra dev pytest",
    "uv run --extra dev ruff check .",
    "uv run --extra dev mypy"
  ],
  "paths": {
    "ai_worklog": "AI_WORKLOG.md",
    "implementation_plan": "docs/IMPLEMENTATION_PLAN.md",
    "specification_root": "spec",
    "specification_index": "spec/README.md",
    "resumable_runs": ".ai/runs",
    "graph_checkpoints": ".ai/graph/checkpoints.sqlite3"
  },
  "github": {
    "claim_label": "ai-in-progress"
  },
  "human_gates": [
    "architecture-decision",
    "claim-ownership-ambiguity",
    "final-merge"
  ],
  "graph": {
    "require_independent_review_model": true,
    "max_retries": {
      "specification": 2,
      "quality_gate": 2,
      "ci": 2,
      "review": 2,
      "merge_conflict": 1
    }
  }
}
